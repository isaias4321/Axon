# Copie para ".env". NUNCA suba o .env real para o GitHub.

PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Chaves que os CLIENTES do seu gateway devem enviar no header x-api-key.
# Não são as chaves da OpenAI/Anthropic — são chaves suas, para controlar
# quem pode usar este gateway. Pode ter várias, separadas por vírgula.
GATEWAY_API_KEYS=dev-key

# Chaves reais dos provedores de IA (defina pelo menos uma para os
# endpoints de chat funcionarem — pode configurar quantas quiser, o
# provedor usado é escolhido por requisição, no campo "provider")
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Google Gemini — tem camada gratuita, sem cartão de crédito.
# Pegue sua chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq — também tem camada gratuita, sem cartão de crédito.
# Pegue sua chave em https://console.groq.com/keys
GROQ_API_KEY=

# Rate limiting: N requisições por janela de tempo, por chave de API
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_MS=60000

# Cache de respostas não-streaming
CACHE_TTL_MS=300000
CACHE_MAX_ENTRIES=500

# Tamanho máximo aceito para upload de arquivos (POST /v1/files/upload),
# em MB. Default: 100. O arquivo inteiro é bufferizado em memória, então
# ajuste conforme a RAM disponível no seu ambiente.
MAX_UPLOAD_SIZE_MB=100

# Timeout máximo de execução do /v1/run (F4-F9), em milissegundos. O loop
# autônomo (F6) pode legitimamente precisar de várias iterações com
# chamadas de LLM — aumente se suas tarefas rotineiramente excedem esse
# tempo. Default: 10 minutos.
RUN_TIMEOUT_MS=600000

# Raiz de trabalho onde o agente opera ferramentas de filesystem/shell/http.
# Por padrão, é o diretório de trabalho do processo ( "workspace" — em
# Docker, /app). Defina para apontar para um volume/escopo seguros se você
# não quiser que as ferramentas do agente interajam com o cwd.
# AXON_WORKSPACE=

# Redis opcional: se definido, cache e rate limiting passam a ser
# distribuídos (compartilhados entre múltiplas réplicas do gateway) em
# vez de isolados em memória por processo. Sem isso definido, o gateway
# funciona normalmente em modo memória — não é obrigatório para rodar
# localmente.
#
# Com Docker Compose (já sobe um Redis junto, ver docker-compose.yml):
# REDIS_URL=redis://redis:6379
#
# Rodando fora do Docker, com Redis local:
# REDIS_URL=redis://localhost:6379
