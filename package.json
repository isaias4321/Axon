{
  "name": "axon-runtime",
  "version": "1.0.0",
  "private": true,
  "description": "Gateway unificado para múltiplos provedores de LLM (OpenAI, Anthropic) com streaming, rate limiting, cache e retry automático.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "adm-zip": "^0.6.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.0",
    "fastify-plugin": "^6.0.0",
    "ioredis": "^6.0.0",
    "jimp": "^1.6.1",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "unicode-properties": "^1.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.2",
    "@types/pdfkit": "^0.17.6",
    "eslint": "^10.8.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
